---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Harsh Kumar — Software Engineer',
  description = 'Harsh Kumar — Full-stack Software Engineer from Prayagraj, India. React, Python, REST APIs. Products designed, built and shipped end to end.',
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='22' fill='%233ecf8e'/><text x='50' y='69' font-size='52' font-family='Arial Black' font-weight='900' text-anchor='middle' fill='%23060606'>H</text></svg>"
    />
  </head>
  <body>
    <!-- LOADER -->
    <div id="loader" aria-hidden="true">
      <div class="loader-inner">
        <div class="loader-top"><span>HK2026 // LOADING</span><span id="loader-pct">00</span></div>
        <div class="loader-big" id="loader-big">HARSH KUMAR</div>
        <div class="loader-bar"><div id="loader-fill"></div></div>
        <div class="loader-sub">FULL-STACK // REACT — PYTHON — REST APIS</div>
      </div>
    </div>

    <!-- NAV -->
    <header id="nav">
      <a href="#home" class="logo">
        <span class="logo-mark">H</span>
        <span>Harsh Kumar</span>
      </a>
      <nav class="nav-links">
        <a href="#about">About</a>
        <a href="#education">Education</a>
        <a href="#achievements">Highlights</a>
        <a href="#coding">Coding</a>
        <a href="#work">Work</a>
        <a href="#services">Services</a>
        <a href="#contact" class="nav-cta">Get in touch ↗</a>
      </nav>
      <button id="menuBtn" aria-label="Open menu"><span></span><span></span><span></span></button>
    </header>

    <!-- FULLSCREEN MENU -->
    <div id="menu">
      <nav>
        <a href="#home"><em>01</em>Home</a>
        <a href="#about"><em>02</em>About</a>
        <a href="#education"><em>03</em>Education</a>
        <a href="#achievements"><em>04</em>Highlights</a>
        <a href="#coding"><em>05</em>Coding</a>
        <a href="#work"><em>06</em>Work</a>
        <a href="#services"><em>07</em>Services</a>
        <a href="#contact"><em>08</em>Contact</a>
      </nav>
      <div class="menu-foot">
        <div>
          <p>GET IN TOUCH</p>
          <a href="mailto:hk40048900@email.com">hk40048900@email.com</a>
          <button class="copy-mail" data-copy="hk40048900@email.com" aria-label="Copy email address" title="Copy email">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2.5"/><path d="M16 8V6.5A2.5 2.5 0 0 0 13.5 4H6.5A2.5 2.5 0 0 0 4 6.5v7A2.5 2.5 0 0 0 6.5 16H8"/></svg>
          </button>
        </div>
        <div class="menu-socials">
          <a href="https://www.linkedin.com/in/harsh-kumar-981475319/" target="_blank" rel="noopener">LinkedIn ↗</a>
          <a href="https://github.com/HarshKumar30" target="_blank" rel="noopener">GitHub ↗</a>
          <a href="https://x.com/HarshKu94194256" target="_blank" rel="noopener">X ↗</a>
          <a href="mailto:hk40048900@email.com">Email ↗</a>
        </div>
      </div>
    </div>

    <slot />

    <footer class="site-footer">
      <div class="wrap">
        <p>© <span id="year">2026</span> Harsh Kumar</p>
        <nav>
          <a href="#about">About</a><a href="#education">Education</a><a href="#work">Work</a><a href="#contact">Contact</a>
        </nav>
        <p>Prayagraj, India</p>
      </div>
    </footer>

    <canvas id="grid-bg" aria-hidden="true"></canvas>

    <script src="../scripts/site.ts"></script>
    <script src="../scripts/grid.ts"></script>
  </body>
</html>
