---
---
<section class="section" id="coding">
  <div class="sec-head" data-reveal>
    <p class="caption"><span class="sec-index">04</span>Coding profiles — live stats</p>
    <h2>Proof, not<br />promises<span class="accent">.</span></h2>
    <p class="sec-sub">Live data from LeetCode and GeeksforGeeks — totals, difficulty breakdowns and recent activity.</p>
  </div>

  <div class="coding-total" data-reveal>
    <h3><span id="codingCombined">166</span><span class="plus">+</span></h3>
    <p>PROBLEMS SOLVED<br />ACROSS PLATFORMS</p>
  </div>

  <div class="coding-grid">
    <article class="code-card" data-reveal>
      <div class="cc-top"><span class="cc-badge lc">LEETCODE</span><a href="https://leetcode.com/u/Harsh_Kumar_096/" target="_blank" rel="noopener">View Profile ↗</a></div>
      <div class="cc-total"><span id="lcTotal">127</span><small>problems solved</small></div>
      <div class="diff-list">
        <div class="diff-row"><span class="diff-label easy">Easy</span><div class="diff-track"><div class="diff-fill easy" id="lcEasyBar" style="width:100%"></div></div><b id="lcEasy">73</b></div>
        <div class="diff-row"><span class="diff-label med">Medium</span><div class="diff-track"><div class="diff-fill med" id="lcMedBar" style="width:56%"></div></div><b id="lcMed">41</b></div>
        <div class="diff-row"><span class="diff-label hard">Hard</span><div class="diff-track"><div class="diff-fill hard" id="lcHardBar" style="width:18%"></div></div><b id="lcHard">13</b></div>
      </div>
      <div class="cc-chips"><span>Acceptance <b id="lcAccept">87%</b></span><span>Rank <b id="lcRank">1.35M</b></span></div>
    </article>

    <article class="code-card" data-reveal>
      <div class="cc-top"><span class="cc-badge gfg">GEEKSFORGEEKS</span><a href="https://www.geeksforgeeks.org/profile/hk4004qt5s" target="_blank" rel="noopener">View Profile ↗</a></div>
      <div class="cc-total"><span id="gfgTotal">39</span><small>problems solved</small></div>
      <div class="diff-list" id="gfgDiffs">
        <div class="diff-row"><span class="diff-label school">School</span><div class="diff-track"><div class="diff-fill school" style="width:0%"></div></div><b>0</b></div>
        <div class="diff-row"><span class="diff-label basic">Basic</span><div class="diff-track"><div class="diff-fill basic" style="width:33%"></div></div><b>7</b></div>
        <div class="diff-row"><span class="diff-label easy">Easy</span><div class="diff-track"><div class="diff-fill easy" style="width:100%"></div></div><b>21</b></div>
        <div class="diff-row"><span class="diff-label med">Medium</span><div class="diff-track"><div class="diff-fill med" style="width:43%"></div></div><b>9</b></div>
        <div class="diff-row"><span class="diff-label hard">Hard</span><div class="diff-track"><div class="diff-fill hard" style="width:10%"></div></div><b>2</b></div>
      </div>
      <div class="cc-chips"><span>Top topics <b>Arrays · Hash · Binary Search</b></span></div>
    </article>
  </div>

  <div class="heatmap-wrap" data-reveal>
    <div class="hm-head">
      <p>LEETCODE ACTIVITY — LAST 12 MONTHS</p>
      <div class="hm-legend"><span>Less</span><i class="lv0"></i><i class="lv1"></i><i class="lv2"></i><i class="lv3"></i><i class="lv4"></i><span>More</span></div>
    </div>
    <div class="heatmap-scroll">
      <div class="hm-months" id="hmMonths" aria-hidden="true"></div>
      <div class="heatmap" id="heatmap" role="img" aria-label="LeetCode submission activity heatmap"></div>
    </div>
    <p class="hm-meta" id="hmMeta">44 active days · refreshed live from LeetCode</p>
  </div>

  <script src="../scripts/coding.ts"></script>
</section>
