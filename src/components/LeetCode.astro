---
const username = 'Harsh_Kumar_096';
const profileUrl = `https://leetcode.com/u/${username}/`;
---

<section class="leetcode" id="leetcode" data-section>
  <div class="leetcode__head">
    <p class="section-label" data-reveal><span class="section-label__num">03</span> / LeetCode</p>
    <h2 class="section-title" data-split-line>
      <span data-line>PROBLEM</span>
      <span data-line>&amp; SOLVED</span>
    </h2>
  </div>

  <div class="leetcode__body">
    <div class="leetcode__profile" data-reveal>
      <a class="leetcode__profile-link" href={profileUrl} target="_blank" rel="noopener noreferrer">
        <span class="leetcode__profile-logo">LC</span>
        <div>
          <p class="leetcode__profile-name">{username}</p>
          <p class="leetcode__profile-handle">LeetCode Profile ↗</p>
        </div>
      </a>
      <div class="leetcode__profile-extras">
        <div class="leetcode__extra">
          <span class="leetcode__extra-num" data-lc-streak>—</span>
          <span class="leetcode__extra-label">Day Streak</span>
        </div>
        <div class="leetcode__extra">
          <span class="leetcode__extra-num" data-lc-active>—</span>
          <span class="leetcode__extra-label">Active Days</span>
        </div>
      </div>
    </div>

    <div class="leetcode__stats" data-lc-stats data-reveal>
      <div class="leetcode__stat">
        <span class="leetcode__stat-number" data-lc-total>—</span>
        <span class="leetcode__stat-label">Total Solved</span>
      </div>
      <div class="leetcode__stat">
        <span class="leetcode__stat-number" data-lc-easy>—</span>
        <span class="leetcode__stat-label">Easy</span>
      </div>
      <div class="leetcode__stat">
        <span class="leetcode__stat-number" data-lc-medium>—</span>
        <span class="leetcode__stat-label">Medium</span>
      </div>
      <div class="leetcode__stat">
        <span class="leetcode__stat-number" data-lc-submissions>—</span>
        <span class="leetcode__stat-label">Submissions</span>
      </div>
    </div>

    <div class="leetcode__heatmap" data-reveal>
      <div class="leetcode__heatmap-head">
        <h3 class="leetcode__heatmap-title">Submission Activity</h3>
        <div class="leetcode__legend">
          <span>Less</span>
          <span class="leetcode__legend-cell" data-level="0"></span>
          <span class="leetcode__legend-cell" data-level="1"></span>
          <span class="leetcode__legend-cell" data-level="2"></span>
          <span class="leetcode__legend-cell" data-level="3"></span>
          <span class="leetcode__legend-cell" data-level="4"></span>
          <span>More</span>
        </div>
      </div>
      <div class="leetcode__calendar-wrap">
        <div class="leetcode__calendar" data-lc-calendar></div>
      </div>
      <p class="leetcode__heatmap-empty" data-lc-calendar-empty hidden>Couldn't load activity. Try again later.</p>
    </div>
  </div>
</section>

<script>
  const username = 'Harsh_Kumar_096';
  const api = 'https://alfa-leetcode-api.onrender.com';

  const $ = (sel) => document.querySelector(sel);

  const totalEl = $('[data-lc-total]');
  const easyEl = $('[data-lc-easy]');
  const mediumEl = $('[data-lc-medium]');
  const submissionsEl = $('[data-lc-submissions]');
  const streakEl = $('[data-lc-streak]');
  const activeEl = $('[data-lc-active]');
  const calendarEl = $('[data-lc-calendar]');
  const calendarEmpty = $('[data-lc-calendar-empty]');

  const MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

  function levelFor(count, max) {
    if (count <= 0) return 0;
    const ratio = count / (max || 1);
    if (ratio <= 0.25) return 1;
    if (ratio <= 0.5) return 2;
    if (ratio <= 0.75) return 3;
    return 4;
  }

  function renderHeatmap(calendarMap) {
    const now = new Date();
    const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
    const start = new Date(today);
    start.setDate(start.getDate() - 364);

    // Build columns of weeks (Sun-first rows like LeetCode/GitHub)
    const firstDow = start.getDay();
    let week = [];
    for (let i = 0; i < firstDow; i++) week.push(null);
    const grid = [];
    let maxCount = 1;

    const day = new Date(start);
    while (day <= today) {
      const dayKey = Math.floor(Date.UTC(day.getFullYear(), day.getMonth(), day.getDate()) / 1000);
      const count = calendarMap[dayKey] || 0;
      if (count > maxCount) maxCount = count;
      week.push({ date: new Date(day), count });
      if (week.length === 7) {
        grid.push(week);
        week = [];
      }
      day.setDate(day.getDate() + 1);
    }
    if (week.length) {
      while (week.length < 7) week.push(null);
      grid.push(week);
    }

    const table = document.createElement('table');
    table.className = 'heatmap';

    // Month labels row
    const monthRow = document.createElement('tr');
    const corner = document.createElement('td');
    corner.className = 'heatmap__corner';
    monthRow.appendChild(corner);
    let prevMonth = null;
    for (let w = 0; w < grid.length; w++) {
      const cell = document.createElement('td');
      cell.className = 'heatmap__month';
      const firstDate = grid[w].find((d) => d);
      const month = firstDate ? firstDate.date.getMonth() : null;
      const year = firstDate ? firstDate.date.getFullYear() : null;
      if (month !== null && month !== prevMonth) {
        cell.textContent = MONTHS[month];
        prevMonth = month;
      }
      monthRow.appendChild(cell);
    }
    table.appendChild(monthRow);

    // Day labels + cells
    for (let r = 0; r < 7; r++) {
      const tr = document.createElement('tr');
      const dayLabel = document.createElement('td');
      dayLabel.className = 'heatmap__day-label';
      dayLabel.textContent = r === 1 ? 'Mon' : r === 3 ? 'Wed' : r === 5 ? 'Fri' : '';
      tr.appendChild(dayLabel);

      for (let w = 0; w < grid.length; w++) {
        const cell = document.createElement('td');
        const day = grid[w][r];
        if (!day) {
          cell.className = 'heatmap__cell heatmap__cell--empty';
        } else {
          const level = levelFor(day.count, maxCount);
          cell.className = `heatmap__cell heatmap__cell--l${level}`;
          const dateStr = `${MONTHS[day.date.getMonth()]} ${day.date.getDate()}, ${day.date.getFullYear()}`;
          cell.title = day.count > 0 ? `${dateStr} — ${day.count} submission${day.count > 1 ? 's' : ''}` : `${dateStr} — no submissions`;
        }
        tr.appendChild(cell);
      }
      table.appendChild(tr);
    }

    calendarEl.innerHTML = '';
    calendarEl.appendChild(table);
  }

  async function loadStatsFromGraphQL() {
    const query = `{
      matchedUser(username: "${username}") {
        submitStatsGlobal {
          acSubmissionNum { difficulty count }
        }
        userCalendar {
          streak
          totalActiveDays
          submissionCalendar
        }
      }
    }`;

    const res = await fetch('https://leetcode.com/graphql', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ query }),
    });
    if (!res.ok) throw new Error('GraphQL request failed');
    const data = await res.json();
    const user = data?.data?.matchedUser;
    if (!user) throw new Error('User not found');

    const ac = user.submitStatsGlobal?.acSubmissionNum || [];
    const countFor = (d) => ac.find((x) => x.difficulty === d)?.count ?? 0;

    return {
      solved: {
        solvedProblem: countFor('All'),
        easySolved: countFor('Easy'),
        mediumSolved: countFor('Medium'),
        totalSubmissionNum: [{ difficulty: 'All', submissions: countFor('All') }],
      },
      cal: {
        streak: user.userCalendar?.streak ?? '—',
        totalActiveDays: user.userCalendar?.totalActiveDays ?? '—',
        submissionCalendar: user.userCalendar?.submissionCalendar ?? '{}',
      },
    };
  }

  async function loadStats() {
    let solved = null;
    let cal = null;

    try {
      const [solvedRes, calRes] = await Promise.all([
        fetch(`${api}/${username}/solved`),
        fetch(`${api}/${username}/calendar`),
      ]);
      if (solvedRes.ok) solved = await solvedRes.json();
      if (calRes.ok) cal = await calRes.json();
    } catch {
      // primary API unreachable, fall back to GraphQL below
    }

    if (!solved || !cal) {
      try {
        const fallback = await loadStatsFromGraphQL();
        if (!solved) solved = fallback.solved;
        if (!cal) cal = fallback.cal;
      } catch {
        // both sources failed; leave placeholders
      }
    }

    if (solved) {
      if (totalEl) totalEl.textContent = solved.solvedProblem ?? '—';
      if (easyEl) easyEl.textContent = solved.easySolved ?? '—';
      if (mediumEl) mediumEl.textContent = solved.mediumSolved ?? '—';
      const subs = solved.totalSubmissionNum?.find((d) => d.difficulty === 'All');
      if (submissionsEl) submissionsEl.textContent = subs?.submissions ?? '—';
    }

    if (cal) {
      if (streakEl) streakEl.textContent = cal.streak ?? '—';
      if (activeEl) activeEl.textContent = cal.totalActiveDays ?? '—';
      try {
        const map = JSON.parse(cal.submissionCalendar || '{}');
        renderHeatmap(map);
      } catch {
        if (calendarEmpty) calendarEmpty.hidden = false;
      }
    }
  }

  loadStats();
</script>

<style is:global>
  .leetcode {
    padding: 8rem 3rem;
    max-width: 1400px;
    margin: 0 auto;
  }

  .section-label {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: 2rem;
  }

  .section-label__num {
    color: #f97316;
    font-weight: 700;
  }

  .section-title {
    font-family: 'Syne', sans-serif;
    font-size: clamp(2.5rem, 7vw, 5.5rem);
    font-weight: 800;
    line-height: 1.02;
    text-transform: uppercase;
  }

  .section-title span {
    display: block;
    overflow: hidden;
  }

  .section-title span:last-child {
    background: linear-gradient(90deg, #f97316, #fb923c, #facc15);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  .leetcode__body {
    margin-top: 4rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .leetcode__profile {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 2rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    background: #0d0d0d;
  }

  .leetcode__profile-link {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    text-decoration: none;
    color: #fff;
    transition: color 0.3s;
  }

  .leetcode__profile-link:hover {
    color: #fb923c;
  }

  .leetcode__profile-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 12px;
    background: linear-gradient(135deg, #f97316, #fb923c);
    color: #fff;
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: 1.2rem;
  }

  .leetcode__profile-name {
    font-family: 'Syne', sans-serif;
    font-size: 1.4rem;
    font-weight: 700;
  }

  .leetcode__profile-handle {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.5);
  }

  .leetcode__profile-extras {
    display: flex;
    gap: 2.5rem;
  }

  .leetcode__extra {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.25rem;
  }

  .leetcode__extra-num {
    font-family: 'Syne', sans-serif;
    font-size: 1.8rem;
    font-weight: 800;
    color: #fb923c;
  }

  .leetcode__extra-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: rgba(255, 255, 255, 0.5);
  }

  .leetcode__stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  .leetcode__stat {
    padding: 1.75rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    background: #0d0d0d;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .leetcode__stat-number {
    font-family: 'Syne', sans-serif;
    font-size: 2.6rem;
    font-weight: 800;
    color: #fb923c;
  }

  .leetcode__stat:nth-child(2) .leetcode__stat-number {
    color: #34d399;
  }

  .leetcode__stat:nth-child(3) .leetcode__stat-number {
    color: #fbbf24;
  }

  .leetcode__stat:nth-child(4) .leetcode__stat-number {
    color: #22d3ee;
  }

  .leetcode__stat-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: rgba(255, 255, 255, 0.5);
  }

  .leetcode__heatmap {
    padding: 2rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    background: #0d0d0d;
  }

  .leetcode__heatmap-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .leetcode__heatmap-title {
    font-family: 'Syne', sans-serif;
    font-size: 1.2rem;
    font-weight: 700;
  }

  .leetcode__legend {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.45);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .leetcode__legend-cell {
    width: 10px;
    height: 10px;
    border-radius: 2px;
  }

  .leetcode__calendar-wrap {
    overflow-x: auto;
  }

  .heatmap {
    border-collapse: separate;
    border-spacing: 2px;
  }

  .heatmap__corner {
    width: 34px;
  }

  .heatmap__month {
    width: 14px;
    height: 14px;
    font-size: 0.65rem;
    color: rgba(255, 255, 255, 0.45);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  .heatmap__day-label {
    height: 12px;
    font-size: 0.6rem;
    color: rgba(255, 255, 255, 0.45);
    padding-right: 0.4rem;
    vertical-align: middle;
    text-align: right;
  }

  .heatmap__cell {
    width: 14px;
    height: 14px;
    border-radius: 3px;
    padding: 0;
    transition: transform 0.15s ease;
  }

  .heatmap__cell:hover {
    transform: scale(1.4);
  }

  .heatmap__cell--empty {
    background: transparent;
  }

  .heatmap__cell--l0 {
    background: rgba(255, 255, 255, 0.06);
  }

  .heatmap__cell--l1 {
    background: rgba(249, 115, 22, 0.25);
  }

  .heatmap__cell--l2 {
    background: rgba(249, 115, 22, 0.5);
  }

  .heatmap__cell--l3 {
    background: rgba(249, 115, 22, 0.75);
  }

  .heatmap__cell--l4 {
    background: #f97316;
  }

  .leetcode__heatmap-empty {
    padding: 1rem 0;
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.9rem;
    font-weight: 300;
  }

  @media (max-width: 900px) {
    .leetcode {
      padding: 5rem 1.25rem;
    }

    .leetcode__stats {
      grid-template-columns: repeat(2, 1fr);
    }

    .leetcode__profile {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
    }

    .leetcode__profile-extras {
      width: 100%;
      justify-content: space-between;
    }

    .leetcode__extra {
      align-items: flex-start;
    }
  }
</style>