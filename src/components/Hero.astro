---
// Hero — iverson voice: eyebrow, momentum headline, proof subline
---
<section class="hero wrap" id="home">
  <canvas id="globe" aria-hidden="true"></canvas>
  <div class="hero-blob b1" aria-hidden="true"></div>
  <div class="hero-blob b2" aria-hidden="true"></div>
  <div class="hero-eyebrow" data-reveal>
    <span class="caption">HK2026</span>
    <span class="caption">Full-stack software engineer — Prayagraj, IN</span>
  </div>

  <h1 class="display hero-title">
    <span class="mask" data-hero-line><span>I build momentum</span></span>
    <span class="mask" data-hero-line><span>that makes <span class="accent">products</span></span></span>
    <span class="mask" data-hero-line><span>impossible to ignore.</span></span>
  </h1>

  <div class="hero-sub">
    <div data-reveal>
      <p class="hero-desc">Harsh Kumar — I design and ship <strong>full-stack products end to end</strong>: React frontends, Python backends, and REST APIs with clean, maintainable code.</p>
      <div class="hero-ctas">
        <a href="#work" class="btn btn-solid magnetic">View the work</a>
        <a href="#contact" class="btn btn-line magnetic">Get in touch</a>
      </div>
      <div class="hero-meta">
        <span>Open to work // 2026</span><i>·</i>
        <a href="mailto:hk40048900@email.com">hk40048900@email.com</a>
      </div>
    </div>
    <div class="hero-media" data-reveal>
      <div class="quote-panel" id="quotePanel" aria-live="polite">
        <span class="quote-mark" aria-hidden="true">&ldquo;</span>
        <p class="quote-text" id="quoteText">Ship early, refactor without fear.</p>
        <span class="caption"><span id="quoteIdx">01</span> / 04</span>
      </div>
      <div class="hero-who">
        <b>Harsh Kumar</b>
        <span class="caption">BSc CSE ’28 · 166+ problems solved</span>
      </div>
    </div>
  </div>

  <div class="hero-foot" data-reveal>
    <a href="#about" class="scroll-pill magnetic">Scroll to continue <span aria-hidden="true">↓</span></a>
    <span class="caption">React · Python · REST APIs</span>
  </div>

  <script src="../scripts/globe.ts"></script>
  <script src="../scripts/quotes.ts"></script>
</section>
