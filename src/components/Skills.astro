---
const CDN = 'https://cdn.jsdelivr.net/gh/devicons/devicon/icons';
const icon = (p: string) => `${CDN}/${p}`;

interface Skill {
  name: string;
  icon?: string;
}
interface Group {
  num: string;
  title: string;
  desc: string;
  skills: Skill[];
}

const groups: Group[] = [
  {
    num: '01',
    title: 'Languages',
    desc: 'When a product outgrows its stack, velocity starts costing money. I write the languages that carry the weight of what comes next.',
    skills: [
      { name: 'C', icon: icon('c/c-original.svg') },
      { name: 'Java', icon: icon('java/java-original.svg') },
      { name: 'Python', icon: icon('python/python-original.svg') },
      { name: 'HTML', icon: icon('html5/html5-original.svg') },
      { name: 'CSS', icon: icon('css3/css3-original.svg') },
      { name: 'JavaScript', icon: icon('javascript/javascript-original.svg') },
      { name: 'TypeScript', icon: icon('typescript/typescript-original.svg') },
      { name: 'SQL' },
    ],
  },
  {
    num: '02',
    title: 'Frameworks',
    desc: 'Ideas die in codebases that were never built to carry them. These turn a good idea into one people cannot put down.',
    skills: [
      { name: 'React', icon: icon('react/react-original.svg') },
      { name: 'Astro', icon: icon('astro/astro-plain.svg') },
      { name: 'Next.js', icon: icon('nextjs/nextjs-original.svg') },
      { name: 'Express', icon: icon('express/express-original.svg') },
      { name: 'Django', icon: icon('django/django-plain.svg') },
    ],
  },
  {
    num: '03',
    title: 'Data & Cloud',
    desc: 'Data is where first impressions turn into real decisions. Stored, queried and served so the decision feels inevitable.',
    skills: [
      { name: 'MongoDB', icon: icon('mongodb/mongodb-original.svg') },
      { name: 'MySQL', icon: icon('mysql/mysql-original.svg') },
      { name: 'PostgreSQL', icon: icon('postgresql/postgresql-original.svg') },
      { name: 'Redis', icon: icon('redis/redis-original.svg') },
      { name: 'Firebase', icon: icon('firebase/firebase-plain.svg') },
      { name: 'Pandas', icon: icon('pandas/pandas-original.svg') },
      { name: 'scikit-learn', icon: icon('scikitlearn/scikitlearn-original.svg') },
    ],
  },
  {
    num: '04',
    title: 'Tooling',
    desc: 'A great deploy does not just get watched; it gets remembered, shared and acted on. Shipping that outlasts the feed it was posted in.',
    skills: [
      { name: 'Git', icon: icon('git/git-original.svg') },
      { name: 'GitHub Actions', icon: icon('githubactions/githubactions-plain.svg') },
      { name: 'Postman', icon: icon('postman/postman-plain.svg') },
      { name: 'Vercel', icon: icon('vercel/vercel-original.svg') },
    ],
  },
];
---
<section class="section" id="services">
  <div class="sec-head" data-reveal>
      <p class="caption"><span class="sec-index">06</span>Services — what I bring to a team</p>
    <h2>Everything a product<br />needs to <span class="accent">ship.</span></h2>
  </div>
  {
    groups.map((g) => (
      <div class="svc-row" data-reveal>
        <div class="svc-num">{g.num}</div>
        <div>
          <h3 class="svc-title">{g.title}</h3>
        </div>
        <div>
          <p class="svc-desc">{g.desc}</p>
          <div class="stack-grid">
            {g.skills.map((s) => (
              <span class="stack">
                {s.icon ? (
                  <img src={s.icon} alt={`${s.name} logo`} loading="lazy" width="22" height="22" data-icon />
                ) : (
                  <b class="stack-text">SQL</b>
                )}
                <i>{s.name}</i>
              </span>
            ))}
          </div>
        </div>
      </div>
    ))
  }
</section>
