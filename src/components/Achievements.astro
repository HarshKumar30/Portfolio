---
const achievements = [
  {
    index: '01',
    title: '100+ Problems Solved',
    description: 'Solved 100+ coding problems across LeetCode, GeeksforGeeks and other competitive programming platforms, sharpening my data structures and algorithms skills.',
    tags: ['LeetCode', 'GFG', 'DSA'],
  },
  {
    index: '02',
    title: 'LeetCode Weekly Contest',
    description: 'Actively participated in LeetCode Weekly Contests, competing against thousands of programmers to solve algorithmic problems under a time limit.',
    tags: ['LeetCode', 'Contest', 'DSA'],
  },
];
---

<section class="achievements" id="achievements" data-section>
  <div class="achievements__head">
    <p class="section-label" data-reveal><span class="section-label__num">02</span> / Achievements</p>
    <h2 class="section-title" data-split-line>
      <span data-line>HIGHLIGHTS</span>
      <span data-line>&amp; WINS</span>
    </h2>
  </div>

  <div class="achievements__list">
    {
      achievements.map((item) => (
        <article class="achievement" data-achievement>
          <span class="achievement__index" data-reveal>{item.index}</span>
          <div class="achievement__content">
            <h3 class="achievement__title" data-reveal>{item.title}</h3>
            <p class="achievement__desc" data-reveal>{item.description}</p>
            <div class="achievement__tags">
              {
                item.tags.map((tag) => (
                  <span class="achievement__tag" data-reveal>{tag}</span>
                ))
              }
            </div>
          </div>
          <div class="achievement__line"></div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .achievements {
    padding: 8rem 3rem;
    background: #0d0d0d;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .section-label {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: 2rem;
  }

  .section-label__num {
    color: #f59e0b;
    font-weight: 700;
  }

  .section-title {
    font-family: 'Syne', sans-serif;
    font-size: clamp(2.5rem, 7vw, 5.5rem);
    font-weight: 800;
    line-height: 1.02;
    text-transform: uppercase;
  }

  .section-title span {
    display: block;
    overflow: hidden;
  }

  .section-title span:last-child {
    background: linear-gradient(90deg, #f59e0b, #fbbf24, #fde047);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  .achievements__head {
    max-width: 1400px;
    margin: 0 auto;
  }

  .achievements__list {
    max-width: 1400px;
    margin: 4rem auto 0;
  }

  .achievement {
    position: relative;
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 2rem;
    padding: 2.5rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    overflow: hidden;
    transition: padding-left 0.5s cubic-bezier(0.77, 0, 0.175, 1);
  }

  .achievement::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(245, 158, 11, 0.04);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 0.5s cubic-bezier(0.77, 0, 0.175, 1);
    z-index: 0;
  }

  .achievement:hover::before {
    transform: scaleY(1);
  }

  .achievement:hover {
    padding-left: 1.5rem;
  }

  .achievement__index {
    font-family: 'Syne', sans-serif;
    font-size: 3rem;
    font-weight: 800;
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(255, 255, 255, 0.25);
    z-index: 1;
  }

  .achievement__content {
    position: relative;
    z-index: 1;
  }

  .achievement__title {
    font-family: 'Syne', sans-serif;
    font-size: clamp(1.4rem, 3vw, 2.2rem);
    font-weight: 700;
    margin-bottom: 0.75rem;
    transition: color 0.3s;
  }

  .achievement:hover .achievement__title {
    background: linear-gradient(90deg, #f59e0b, #fbbf24, #fde047);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  .achievement__desc {
    font-weight: 300;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.7);
    max-width: 720px;
    margin-bottom: 1rem;
  }

  .achievement__tags {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .achievement__tag {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 0.4rem 0.9rem;
    border: 1px solid rgba(245, 158, 11, 0.3);
    border-radius: 100px;
    color: #f59e0b;
  }

  .achievement__line {
    position: absolute;
    bottom: 0;
    left: 0;
    height: 2px;
    width: 100%;
    background: linear-gradient(90deg, #f59e0b, #fbbf24);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s cubic-bezier(0.77, 0, 0.175, 1);
  }

  .achievement:hover .achievement__line {
    transform: scaleX(1);
  }

  @media (max-width: 768px) {
    .achievements {
      padding: 5rem 1.25rem;
    }

    .achievement {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
</style>